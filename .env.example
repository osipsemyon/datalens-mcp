# Copy this file to `.env` (same folder) and fill it in — the server auto-loads `.env` at startup.
# Real environment variables (e.g. set in your MCP client config) always take precedence over `.env`.
# You can also point elsewhere with DATALENS_ENV_FILE=/path/to/.env

# --- Auth (both required) ---

# A ready-to-use IAM token (short-lived, ~12h — refresh it when it expires):
#   yc iam create-token
# Note: Yandex OAuth tokens are NOT supported (the OAuth→IAM exchange was discontinued for
# tokens issued after 2026-06-01). Provide an IAM token here.
DATALENS_IAM_TOKEN=

# Organization ID (Settings → Service settings in DataLens). Sent as the required
# x-dl-org-id header — every request fails without it.
DATALENS_ORG_ID=

# --- Optional ---
# Override for self-hosted / opensource DataLens. Default: https://api.datalens.tech
# Must be https (the IAM token is sent to it on every request); http is allowed only for localhost.
# DATALENS_API_BASE=https://api.datalens.tech
# Allow an http:// base to a self-hosted host on a trusted network (otherwise https is required):
# DATALENS_ALLOW_INSECURE_BASE=1
# Register ONLY read tools — a hard, opt-in write guarantee (no create/modify tool exists to call):
# DATALENS_READ_ONLY=1
# DATALENS_API_VERSION=1
# Per-request timeout in milliseconds (default 60000).
# DATALENS_TIMEOUT_MS=60000
# Max chars returned inline before a result is spilled to a temp file (default 5000000;
# 0 = never spill / unlimited). Results are always complete, valid JSON — never truncated.
# DATALENS_MAX_RESPONSE_CHARS=5000000

# --- Launcher only (bin/datalens-launch.sh), not read by the server itself ---
# Mint a fresh IAM token via `yc iam create-token` on each start (no token stored on disk).
# Requires the yc CLI logged in (`yc init`). When set, DATALENS_IAM_TOKEN above is not needed.
# DATALENS_USE_YC_TOKEN=1
